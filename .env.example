# ==============================================================================
# CrowdFlow India - Docker Environment Configuration (.env.example)
# ==============================================================================

# Application & Gateway Ports (Mapped to Host)
APP_PORT=8085
GATEWAY_PORT=8088
DB_PORT=5432
REDIS_PORT=6382
PGWEB_PORT=8089

# Spatial Database Configuration (PostgreSQL 16 + PostGIS 3.4)
POSTGRES_DB=waterwatch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=postgres

# Redis Cache Configuration
REDIS_HOST=redis
REDIS_PORT_INTERNAL=6379

# Active Spring Profile (postgres for production & docker testing with PostGIS)
SPRING_PROFILES_ACTIVE=postgres

# JVM Tuning for Java 25 & Virtual Threads
JAVA_OPTS=-Dspring.classformat.ignore=true -XX:+UseZGC -Xms256m -Xmx1024m -Djava.awt.headless=true -Dfile.encoding=UTF-8

# Storage Configuration (Local filesystem default; S3 optional)
S3_ENABLED=false
